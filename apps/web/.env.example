# Copy to .env.local (never commit it). Operator fills these in; see README.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Strava
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# App and Solana (devnet only)
APP_URL=http://localhost:3000
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_TREASURY_ADDRESS=
TREASURY_SECRET_KEY=

# n8n calls POST /api/settlement/run with this as a Bearer token
SETTLEMENT_API_SECRET=

# Operator-only POST /api/admin/reset; leave empty to disable the endpoint.
ADMIN_RESET_SECRET=
