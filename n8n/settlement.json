      "parameters": {
        "jsCode": "// Aggregates only: the app never sends names, wallets or fitness data here.\nconst r = $input.first().json;\nconst lines = (r.pacts ?? []).map((p) =>\n  `${p.title}: ${p.cleared} of ${p.funded} made it, ${p.paidOutSol} SOL paid out, ${p.refundedSol} SOL refunded, 0 SOL in fees` +\n  (p.status === 'done' ? '' : ' (payouts still sending)') +\n  `. Receipt: ${p.receiptUrl}`\n);\nreturn [{ json: {\n  newlySettled: r.newlySettled ?? 0,\n  summary: lines.length ? lines.join('\\n') : 'Nothing due for settlement.',\n  pacts: r.pacts ?? []\n} }];"
